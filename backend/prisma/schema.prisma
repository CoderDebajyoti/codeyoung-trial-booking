generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Mentor {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  timeZone      String    // e.g. "Asia/Kolkata", "America/New_York", "Europe/London"
  isActive      Boolean   @default(true)
  workDays      Int[]     @default([1, 2, 3, 4, 5]) // 1=Monday ... 7=Sunday
  workStartHour Int       @default(9)  // Local start hour: 09:00
  workEndHour   Int       @default(17) // Local end hour: 17:00
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]

  @@map("mentors")
}

model Parent {
  id        String    @id @default(uuid())
  name      String
  email     String
  timeZone  String    // e.g. "America/New_York"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]

  @@index([email])
  @@map("parents")
}

model Booking {
  id             String        @id @default(uuid())
  parentId       String
  mentorId       String
  startAt        DateTime      // Stored as UTC timestamp
  endAt          DateTime      // Stored as UTC timestamp (startAt + 30 mins)
  parentTimeZone String        // e.g. "America/New_York"
  mentorTimeZone String        // e.g. "Asia/Kolkata"
  status         BookingStatus @default(CONFIRMED)
  demoClassUrl   String
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  parent         Parent        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  mentor         Mentor        @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId, status, startAt, endAt])
  @@index([mentorId, startAt])
  @@map("bookings")
}
