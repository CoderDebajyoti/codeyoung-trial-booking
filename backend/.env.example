# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codeyoung_booking?schema=public"

# Meeting link configuration
DEMO_CLASS_BASE_URL=https://meet.codeyoung.com/trial

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# Options: 'resend' | 'smtp' | 'mailpit' | 'mock' | 'test'
#   - 'resend' : Uses Resend API via RESEND_API_KEY (Recommended for production)
#   - 'smtp'   : Standard SMTP (Gmail App Password, SendGrid, AWS SES, Mailgun)
#   - 'mailpit': Local developer SMTP (localhost:1025)
#   - 'mock'   : In-memory simulation (for automated tests / dev preview)
EMAIL_PROVIDER=mock
EMAIL_FROM="Codeyoung <trial@codeyoung.com>"
# Optional: In Resend sandbox testing (onboarding@resend.dev), redirect all notifications to your verified email
EMAIL_OVERRIDE_RECIPIENT=

# 1. Option A: Resend API Configuration
# Get key from https://resend.com
RESEND_API_KEY=

# 2. Option B: SMTP Configuration (Gmail, SendGrid, Mailgun, AWS SES, Mailpit)
# Gmail: host=smtp.gmail.com, port=465, secure=true, user=you@gmail.com, pass=16-char-app-password
# SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=SG.xxx
# Mailpit: host=localhost, port=1025, secure=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# 3. Notification & Reminder Worker
NOTIFICATION_WORKER_ENABLED=true
REMINDER_INTERVAL_SECONDS=10

# ==============================================================================
# SECURITY & BOT PROTECTION
# ==============================================================================
# JWT Authentication Secret for Mentors & Administrators
JWT_SECRET=your-super-secure-256-bit-secret-key-here
JWT_EXPIRES_IN=24h

# Cloudflare Turnstile CAPTCHA (Public Booking & Login Protection)
# Get credentials at https://dash.cloudflare.com/?to=/:account/turnstile
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Parent Email OTP Verification
OTP_ENABLED=true
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate Limiting
RATE_LIMIT_ENABLED=true
